# Cloud backup covers ONLY the root paths whitelisted below, nothing else.
# Everything is whitelisted on purpose except machine-local, generated and secret files.
# Keep this list in step with AGENTS.md section 3 (the folder map).
/*
!/.gitignore
!/save-to-cloud.cmd
!/FOR-HQ.md
!/FOR-FADY.md
!/SCORE.md
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/hooks/
!/.claude/scripts/
!/.claude/settings.json
!/AGENTS.md
!/CLAUDE.md
!/STATE.md
!/NOW.md
!/DECISIONS.md
!/LOG.md
!/HANDOFF.md
!/playbook/
!/research/
!/assets/
!/site-v1/
!/design/
!/_archive/

# the waiting room for spent files is never backed up (the monthly 30-day pass empties it, AGENTS.md section 3)
/to-delete/

# generated per-session scratch state of the logging guard (added 2026-09-04, shared kit), never history
/.claude/hooks/state/

# never track these, anywhere (the three secret lines and *.log added 2026-09-20, kit template)
.env
.env.*
secrets/
node_modules/
.wrangler/
*.bak
*.bak-*
*.log
Thumbs.db
.DS_Store
